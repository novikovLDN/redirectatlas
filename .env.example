# Admin Telegram user IDs — comma-separated for multiple admins
# ADMIN_IDS=123456789,987654321
# Or single admin (backward compatible):
# ADMIN_ID=123456789
ADMIN_IDS=

# PostgreSQL connection URL (Railway sets this automatically when you link a Postgres service)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Telegram bot tokens (at least BOT_TOKEN_1 is required)
# Up to 400 bots are supported: BOT_TOKEN_1 .. BOT_TOKEN_400.
# Leave unused ones empty — they are skipped.
