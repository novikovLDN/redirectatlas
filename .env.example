# Per-bot referral links (optional, falls back to DEFAULT_REFERRAL_LINK)
# REFERRAL_LINK_1=https://t.me/atlassecure_bot?start=ref_CUSTOM1
# REFERRAL_LINK_2=https://t.me/atlassecure_bot?start=ref_CUSTOM2

# Default referral link used when per-bot link is not set
DEFAULT_REFERRAL_LINK=https://t.me/atlassecure_bot?start=ref_UEGJ3A

# ── Tuning (optional, defaults are fine) ───────────────────────────────
# Maximum number of bots served by the process
# MAX_BOTS=400
# How many bots are initialized in parallel on boot
# INIT_BATCH=20
# How many bots broadcast in parallel
# BROADCAST_CONCURRENCY=25
# Pause between two messages of the same bot, seconds
# SEND_DELAY=0.04
# Postgres pool size
# DB_POOL_MIN=5
# DB_POOL_MAX=40

# ── Auto broadcast ("we are moving to a new bot") ──────────────────────
# How often the broadcast is sent automatically, days
# AUTO_BROADCAST_DAYS=7
# Text of the button under that broadcast
# AUTO_BROADCAST_BUTTON_TEXT=🚀 Перейти в новый бот
